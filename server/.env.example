# Port Server Backend
PORT=5000

# Konfigurasi Database PostgreSQL
# Opsi 1: Menggunakan connection string lengkap (Cloud / Neon / Supabase / Lokal)
# Contoh lokal: postgresql://postgres:password_kamu@localhost:5432/creative_office
# Contoh cloud: postgresql://user:password@ep-something.ap-southeast-1.neon.tech/creative_office?sslmode=require
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/creative_office

# Opsi 2: Konfigurasi per variabel (jika tidak menggunakan DATABASE_URL)
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=creative_office
DB_SSL=false
